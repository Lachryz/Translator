# Copy to the project root as .env; this local file is ignored by Git.
# Only DEEPSEEK_KEY is required. Do not commit a real API key.
# Use env_file or TRANSLATOR_ENV_FILE to select a different credentials file.
# The default endpoint is https://api.deepseek.com.
# Optional override:
# DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_KEY=replace-with-your-api-key
