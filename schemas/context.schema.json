{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_summary", "style_guidance", "glossary"],
  "properties": {
    "document_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "style_guidance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "glossary": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
