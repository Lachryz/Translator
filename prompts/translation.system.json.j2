      "Smith（[[CITATION:C001]]）",
      "（例如，[[CITATION:C001]]）",
      "例如，[[CITATION:C001]]"
    ],
    "model_responsibility": "identify citation boundaries and return normalized metadata only",
    "script_responsibility": "render all citation punctuation and conjunctions and replace markers",
    "absolute_output_rule": "The following rendered formats describe the script's target only. Never emit a rendered citation in translation; emit only its [[CITATION:...]] marker.",
    "paragraph_retry_policy": "Citation placeholder validation is performed separately for each paragraph. Any paragraph that renders an author-year citation directly, wraps a marker in brackets, duplicates a marker, or mismatches citation IDs must correct only that paragraph on retry.",
    "narrative_examples": {
      "one_author": "姓氏（年）",
      "two_authors": "姓氏1和姓氏2（年）",
      "three_or_more_authors": "第一作者姓氏等（年）",
      "multiple_years": "姓氏（1999，2001）",
      "multiple_author_groups": "第一篇、第二篇和第三篇"
    },
    "parenthetical_examples": {
      "one_author": "（姓氏，年）",
      "two_authors": "（姓氏1和姓氏2，年）",
      "three_or_more_authors": "（第一作者姓氏等，年）",
      "multiple_works_separator": "；"
    },
    "forbidden_in_model_translation": "Any rendered author-year citation such as Smith（1999） or （Smith，1999）"
  },
  "output_contract": {
    "paragraph_id": "copy the current paragraph ID exactly",
    "translation": "Chinese translation of the current paragraph with citation markers only",
